<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.rosato.controlador.EditarMaquinaController"
            prefWidth="720" prefHeight="640" styleClass="root">
    <top>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <padding><Insets top="14" right="20" bottom="12" left="20"/></padding>
            <Label fx:id="lblTitulo" text="Nueva máquina" styleClass="titulo"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button text="Volver" styleClass="btn-secundario" onAction="#onVolver"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="10" styleClass="tarjeta">
            <padding><Insets top="6" right="20" bottom="20" left="20"/></padding>

            <GridPane hgap="12" vgap="10">
                <Label text="Código *"    GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="txtCodigo" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Nombre *"    GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="txtNombre" prefWidth="360" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Tipo *"      GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <ChoiceBox fx:id="cbTipo" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Marca"       GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <TextField fx:id="txtMarca" prefWidth="240" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label text="Modelo"      GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <TextField fx:id="txtModelo" prefWidth="240" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                <Label text="Serial"      GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                <TextField fx:id="txtSerial" prefWidth="240" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                <Label text="Fecha adquisición" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                <DatePicker fx:id="dpAdquisicion" GridPane.columnIndex="1" GridPane.rowIndex="6"/>

                <Label text="Estado"      GridPane.columnIndex="0" GridPane.rowIndex="7"/>
                <ChoiceBox fx:id="cbEstado" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="7"/>

                <Label text="Próxima revisión" GridPane.columnIndex="0" GridPane.rowIndex="8"/>
                <DatePicker fx:id="dpProxRev" GridPane.columnIndex="1" GridPane.rowIndex="8"/>

                <Label text="Ubicación"   GridPane.columnIndex="0" GridPane.rowIndex="9"/>
                <TextField fx:id="txtUbicacion" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="9"/>

                <Label text="Notas"       GridPane.columnIndex="0" GridPane.rowIndex="10"/>
                <TextArea fx:id="txtNotas" prefRowCount="3" prefWidth="360"
                          GridPane.columnIndex="1" GridPane.rowIndex="10"/>

                <CheckBox fx:id="chkActivo" text="Activa" selected="true"
                          GridPane.columnIndex="1" GridPane.rowIndex="11"/>
            </GridPane>

            <Label fx:id="lblMensaje" styleClass="error" visible="false" managed="false" wrapText="true"/>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="Cancelar" styleClass="btn-secundario" onAction="#onVolver"/>
                <Button text="Guardar"  styleClass="btn-principal"  onAction="#onGuardar"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
