<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.rosato.controlador.EditarEmpleadoController"
            prefWidth="760" prefHeight="720" styleClass="root">
    <top>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <padding><Insets top="14" right="20" bottom="12" left="20"/></padding>
            <Label fx:id="lblTitulo" text="Nuevo empleado" styleClass="titulo"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button text="Volver" styleClass="btn-secundario" onAction="#onVolver"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="10" styleClass="tarjeta">
            <padding><Insets top="6" right="20" bottom="20" left="20"/></padding>

            <GridPane hgap="12" vgap="10">
                <Label text="Nombre completo *" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="txtNombre" prefWidth="360" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Cédula" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="txtCedula" prefWidth="180" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Teléfono" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="txtTelefono" prefWidth="160" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Usuario *" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <TextField fx:id="txtUsuario" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label text="Contraseña" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <PasswordField fx:id="txtContrasena" prefWidth="220"
                               GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                <Label fx:id="lblAyudaPass" text="(vacío = no cambiar)" styleClass="hint"
                       GridPane.columnIndex="2" GridPane.rowIndex="4"/>

                <Label text="Área de trabajo *" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                <ChoiceBox fx:id="cbArea" prefWidth="220"
                           GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                <Label text="Experiencia" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                <TextField fx:id="txtExperiencia" prefWidth="320"
                           GridPane.columnIndex="1" GridPane.rowIndex="6"/>

                <Label text="Disponibilidad" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
                <TextField fx:id="txtDisponibilidad" prefWidth="320"
                           GridPane.columnIndex="1" GridPane.rowIndex="7"/>

                <Label text="Salario (RD$)" GridPane.columnIndex="0" GridPane.rowIndex="8"/>
                <TextField fx:id="txtSalario" prefWidth="160" GridPane.columnIndex="1" GridPane.rowIndex="8"/>

                <Label text="Fecha contratación" GridPane.columnIndex="0" GridPane.rowIndex="9"/>
                <DatePicker fx:id="dpContratacion" GridPane.columnIndex="1" GridPane.rowIndex="9"/>

                <Label text="Fecha nacimiento" GridPane.columnIndex="0" GridPane.rowIndex="10"/>
                <DatePicker fx:id="dpNacimiento" GridPane.columnIndex="1" GridPane.rowIndex="10"/>

                <Label text="Prueba embarazo" GridPane.columnIndex="0" GridPane.rowIndex="11"/>
                <DatePicker fx:id="dpPrueba" GridPane.columnIndex="1" GridPane.rowIndex="11"/>

                <CheckBox fx:id="chkActivo" text="Activo" selected="true"
                          GridPane.columnIndex="1" GridPane.rowIndex="12"/>
            </GridPane>

            <Label fx:id="lblMensaje" styleClass="error" visible="false" managed="false" wrapText="true"/>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="Cancelar" styleClass="btn-secundario" onAction="#onVolver"/>
                <Button text="Guardar"  styleClass="btn-principal"  onAction="#onGuardar"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
