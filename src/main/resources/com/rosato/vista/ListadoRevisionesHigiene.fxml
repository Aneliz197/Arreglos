<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.rosato.controlador.ListadoRevisionesHigieneController"
            prefWidth="1060" prefHeight="620" styleClass="root">

    <top>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <padding><Insets top="14" right="20" bottom="12" left="20"/></padding>
            <Label text="Revisiones de higiene" styleClass="titulo"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button text="+ Nueva"   styleClass="btn-principal"  onAction="#onNueva"/>
            <Button text="Editar"    styleClass="btn-secundario" onAction="#onEditar"/>
            <Button text="Refrescar" styleClass="btn-secundario" onAction="#onRefrescar"/>
            <Button text="Volver"    styleClass="btn-secundario" onAction="#onVolver"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="10">
            <padding><Insets top="6" right="20" bottom="20" left="20"/></padding>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Desde:"/><DatePicker fx:id="dpDesde"/>
                <Label text="Hasta:"/><DatePicker fx:id="dpHasta"/>
                <Label text="Área:"/><ChoiceBox fx:id="cbArea"/>
                <Button text="Buscar" styleClass="btn-principal" onAction="#onBuscar"/>
            </HBox>

            <TableView fx:id="tblRevisiones" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId"     text="ID"      prefWidth="60"/>
                    <TableColumn fx:id="colFecha"  text="Fecha"   prefWidth="110"/>
                    <TableColumn fx:id="colArea"   text="Área"    prefWidth="170"/>
                    <TableColumn fx:id="colResp"   text="Responsable" prefWidth="200"/>
                    <TableColumn fx:id="colPct"    text="% Cumple" prefWidth="100"/>
                    <TableColumn fx:id="colEstado" text="Estado"  prefWidth="120"/>
                    <TableColumn fx:id="colObs"   text="Observaciones" prefWidth="280"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
