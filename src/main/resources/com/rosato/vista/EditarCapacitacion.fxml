<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.rosato.controlador.EditarCapacitacionController"
            prefWidth="900" prefHeight="720" styleClass="root">
    <top>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <padding><Insets top="14" right="20" bottom="12" left="20"/></padding>
            <Label fx:id="lblTitulo" text="Nueva capacitación" styleClass="titulo"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button text="Volver" styleClass="btn-secundario" onAction="#onVolver"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="14">
            <padding><Insets top="6" right="20" bottom="20" left="20"/></padding>

            <VBox styleClass="tarjeta" spacing="8">
                <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>
                <Label text="Información" styleClass="subtitulo"/>
                <GridPane hgap="12" vgap="10">
                    <Label text="Título *"  GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtTitulo" prefWidth="360"
                               GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="Fecha *"   GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <DatePicker fx:id="dpFecha" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Instructor" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextField fx:id="txtInstructor" prefWidth="260"
                               GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                    <Label text="Horas"      GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <TextField fx:id="txtHoras" prefWidth="120"
                               GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                    <Label text="Ubicación"  GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                    <TextField fx:id="txtUbicacion" prefWidth="260"
                               GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                    <Label text="Descripción" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                    <TextArea fx:id="txtDescripcion" prefRowCount="3" prefWidth="360"
                              GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                </GridPane>
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button text="Guardar información" styleClass="btn-principal" onAction="#onGuardar"/>
                </HBox>
                <Label fx:id="lblMensaje" styleClass="error" visible="false" managed="false" wrapText="true"/>
            </VBox>

            <VBox styleClass="tarjeta" spacing="8" fx:id="panelAsistentes">
                <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>
                <Label text="Asistentes" styleClass="subtitulo"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Agregar:"/>
                    <ComboBox fx:id="cbEmpleado" prefWidth="280"/>
                    <Button text="+ Agregar"  styleClass="btn-secundario" onAction="#onAgregarAsistente"/>
                    <Button text="Guardar asistencias" styleClass="btn-principal" onAction="#onGuardarAsistencias"/>
                    <Button text="Quitar"     styleClass="btn-secundario" onAction="#onQuitarAsistente"/>
                </HBox>
                <TableView fx:id="tblAsistentes" editable="true" prefHeight="220">
                    <columns>
                        <TableColumn fx:id="colEmpleado"  text="Empleado"   prefWidth="240"/>
                        <TableColumn fx:id="colArea"      text="Área"       prefWidth="140"/>
                        <TableColumn fx:id="colAsistio"   text="Asistió"    prefWidth="80"/>
                        <TableColumn fx:id="colCalif"     text="Calif."     prefWidth="90"/>
                        <TableColumn fx:id="colObs"       text="Observaciones" prefWidth="260"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
