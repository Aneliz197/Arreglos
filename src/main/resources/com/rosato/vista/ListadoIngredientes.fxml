<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.rosato.controlador.ListadoIngredientesController"
            prefWidth="960" prefHeight="620" styleClass="root">

    <top>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <padding><Insets top="14" right="20" bottom="12" left="20"/></padding>
            <Label text="Inventario de ingredientes" styleClass="titulo"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button text="+ Nuevo" styleClass="btn-principal"  onAction="#onNuevo"/>
            <Button text="Editar"  styleClass="btn-secundario" onAction="#onEditar"/>
            <Button text="Refrescar" styleClass="btn-secundario" onAction="#onRefrescar"/>
            <Button text="Volver"    styleClass="btn-secundario" onAction="#onVolver"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="10">
            <padding><Insets top="6" right="20" bottom="20" left="20"/></padding>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="txtBuscar" promptText="Buscar por nombre" prefWidth="320"/>
                <Button text="Buscar" styleClass="btn-principal" onAction="#onBuscar"/>
                <Label fx:id="lblAlerta" styleClass="error"/>
            </HBox>

            <TableView fx:id="tblIngredientes" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId"       text="ID"            prefWidth="60"/>
                    <TableColumn fx:id="colNombre"   text="Nombre"        prefWidth="220"/>
                    <TableColumn fx:id="colUnidad"   text="Unidad"        prefWidth="80"/>
                    <TableColumn fx:id="colStock"    text="Stock actual"  prefWidth="120"/>
                    <TableColumn fx:id="colMinimo"   text="Stock mínimo"  prefWidth="120"/>
                    <TableColumn fx:id="colCosto"    text="Costo prom."   prefWidth="120"/>
                    <TableColumn fx:id="colAlerta"   text="Estado"        prefWidth="140"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
