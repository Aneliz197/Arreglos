<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.rosato.controlador.AgendaEntregasController"
            prefWidth="1100" prefHeight="640" styleClass="root">

    <top>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <padding><Insets top="14" right="20" bottom="12" left="20"/></padding>
            <Label text="Agenda de entregas" styleClass="titulo"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Label text="Fecha:"/>
            <DatePicker fx:id="dpFecha"/>
            <Label text="Estado:"/>
            <ChoiceBox fx:id="cbEstado"/>
            <Button text="Cargar" styleClass="btn-principal"  onAction="#onCargar"/>
            <Button text="Volver" styleClass="btn-secundario" onAction="#onVolver"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="10">
            <padding><Insets top="6" right="20" bottom="20" left="20"/></padding>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="Asignar repartidor"  styleClass="btn-secundario" onAction="#onAsignar"/>
                <Button text="Marcar en ruta"      styleClass="btn-secundario" onAction="#onEnRuta"/>
                <Button text="Entregar y cobrar"   styleClass="btn-principal"  onAction="#onEntregar"/>
                <Button text="Fallida"             styleClass="btn-secundario" onAction="#onFallida"/>
            </HBox>

            <TableView fx:id="tblEntregas" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId"        text="ID"          prefWidth="50"/>
                    <TableColumn fx:id="colPedido"    text="Pedido"      prefWidth="70"/>
                    <TableColumn fx:id="colHora"      text="Hora prog."  prefWidth="100"/>
                    <TableColumn fx:id="colCliente"   text="Cliente"     prefWidth="200"/>
                    <TableColumn fx:id="colTipo"      text="Tipo"        prefWidth="100"/>
                    <TableColumn fx:id="colDireccion" text="Dirección"   prefWidth="220"/>
                    <TableColumn fx:id="colEstado"    text="Estado"      prefWidth="110"/>
                    <TableColumn fx:id="colSaldo"     text="Saldo"       prefWidth="100"/>
                    <TableColumn fx:id="colRepartidor" text="Repartidor" prefWidth="140"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
