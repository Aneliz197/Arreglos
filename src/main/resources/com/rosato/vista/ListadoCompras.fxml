<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.rosato.controlador.ListadoComprasController"
            prefWidth="960" prefHeight="600" styleClass="root">

    <top>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <padding><Insets top="14" right="20" bottom="12" left="20"/></padding>
            <Label text="Compras" styleClass="titulo"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button text="+ Nueva compra" styleClass="btn-principal"  onAction="#onNueva"/>
            <Button text="Refrescar"      styleClass="btn-secundario" onAction="#onRefrescar"/>
            <Button text="Volver"         styleClass="btn-secundario" onAction="#onVolver"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="10">
            <padding><Insets top="6" right="20" bottom="20" left="20"/></padding>
            <TableView fx:id="tblCompras" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId"       text="ID"        prefWidth="60"/>
                    <TableColumn fx:id="colFecha"    text="Fecha"     prefWidth="160"/>
                    <TableColumn fx:id="colProv"     text="Proveedor" prefWidth="240"/>
                    <TableColumn fx:id="colFactura"  text="Factura"   prefWidth="140"/>
                    <TableColumn fx:id="colTotal"    text="Total"     prefWidth="140"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
