<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.rosato.controlador.ListadoPedidosController"
            prefWidth="960" prefHeight="600" styleClass="root">

    <top>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <padding><Insets top="14" right="20" bottom="12" left="20"/></padding>
            <Label text="Pedidos" styleClass="titulo"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button text="Nuevo pedido" styleClass="btn-principal" onAction="#onNuevo"/>
            <Button text="Refrescar" styleClass="btn-secundario" onAction="#onRefrescar"/>
            <Button text="Volver" styleClass="btn-secundario" onAction="#onVolver"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="10">
            <padding><Insets top="6" right="20" bottom="20" left="20"/></padding>

            <TableView fx:id="tblPedidos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="colCliente" text="Cliente" prefWidth="180"/>
                    <TableColumn fx:id="colFechaPedido" text="Fecha pedido" prefWidth="150"/>
                    <TableColumn fx:id="colFechaEntrega" text="Fecha entrega" prefWidth="150"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="150"/>
                    <TableColumn fx:id="colTotal" text="Total (RD$)" prefWidth="120"/>
                    <TableColumn fx:id="colSaldo" text="Saldo" prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
