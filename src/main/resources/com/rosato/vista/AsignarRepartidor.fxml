<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.rosato.controlador.AsignarRepartidorController"
            prefWidth="620" prefHeight="440" styleClass="root">

    <top>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <padding><Insets top="14" right="20" bottom="12" left="20"/></padding>
            <Label text="Asignar repartidor" styleClass="titulo"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button text="Volver" styleClass="btn-secundario" onAction="#onVolver"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="14">
            <padding><Insets top="6" right="20" bottom="20" left="20"/></padding>

            <Label fx:id="lblCabecera" styleClass="subtitulo"/>

            <GridPane hgap="12" vgap="10" styleClass="tarjeta">
                <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>
                <Label text="Repartidor" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <ComboBox fx:id="cbRepartidor" prefWidth="300"
                          GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Dirección" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="txtDireccion" prefWidth="360"
                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Notas" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextArea fx:id="txtNotas" prefRowCount="3" prefWidth="360"
                          GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            </GridPane>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Label fx:id="lblMensaje" styleClass="error" visible="false" managed="false" wrapText="true"/>
                <HBox HBox.hgrow="ALWAYS"/>
                <Button text="Cancelar" styleClass="btn-secundario" onAction="#onVolver"/>
                <Button text="Guardar" styleClass="btn-principal" onAction="#onGuardar"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
