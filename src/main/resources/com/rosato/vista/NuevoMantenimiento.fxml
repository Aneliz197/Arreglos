<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.rosato.controlador.NuevoMantenimientoController"
            prefWidth="700" prefHeight="560" styleClass="root">
    <top>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <padding><Insets top="14" right="20" bottom="12" left="20"/></padding>
            <Label text="Nuevo mantenimiento" styleClass="titulo"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button text="Volver" styleClass="btn-secundario" onAction="#onVolver"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="10" styleClass="tarjeta">
            <padding><Insets top="6" right="20" bottom="20" left="20"/></padding>

            <GridPane hgap="12" vgap="10">
                <Label text="Máquina *"    GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <ComboBox fx:id="cbMaquina" prefWidth="360"
                          GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Tipo *"       GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <ChoiceBox fx:id="cbTipo"  prefWidth="200"
                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Fecha *"      GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <DatePicker fx:id="dpFecha" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Técnico"      GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <TextField fx:id="txtTecnico" prefWidth="280"
                           GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label text="Costo (RD$)"  GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <TextField fx:id="txtCosto" prefWidth="160"
                           GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                <Label text="Descripción"  GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                <TextArea fx:id="txtDescripcion" prefRowCount="3" prefWidth="360"
                          GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                <Label text="Próxima revisión" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                <DatePicker fx:id="dpProxRev" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
            </GridPane>

            <Label fx:id="lblMensaje" styleClass="error" visible="false" managed="false" wrapText="true"/>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="Cancelar" styleClass="btn-secundario" onAction="#onVolver"/>
                <Button text="Registrar" styleClass="btn-principal" onAction="#onGuardar"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
