<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.rosato.controlador.NuevaCompraController"
            prefWidth="1000" prefHeight="680" styleClass="root">

    <top>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <padding><Insets top="14" right="20" bottom="12" left="20"/></padding>
            <Label text="Nueva compra" styleClass="titulo"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button text="Volver" styleClass="btn-secundario" onAction="#onVolver"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="14">
            <padding><Insets top="6" right="20" bottom="20" left="20"/></padding>

            <VBox styleClass="tarjeta" spacing="10">
                <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>
                <Label text="Cabecera" styleClass="subtitulo"/>
                <GridPane hgap="12" vgap="8">
                    <Label text="Proveedor *" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <ComboBox fx:id="cbProveedor" GridPane.columnIndex="1" GridPane.rowIndex="0"
                              prefWidth="340"/>

                    <Label text="No. factura" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtFactura" GridPane.columnIndex="1" GridPane.rowIndex="1"
                               prefWidth="200"/>

                    <Label text="Observaciones" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextField fx:id="txtObservaciones" GridPane.columnIndex="1" GridPane.rowIndex="2"
                               prefWidth="340"/>
                </GridPane>
            </VBox>

            <VBox styleClass="tarjeta" spacing="10">
                <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>
                <Label text="Agregar ingrediente" styleClass="subtitulo"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <ComboBox fx:id="cbIngrediente" prefWidth="280" promptText="Ingrediente"/>
                    <TextField fx:id="txtCantidad" prefWidth="110" promptText="Cantidad"/>
                    <TextField fx:id="txtPrecio"   prefWidth="140" promptText="Precio unitario"/>
                    <Button text="+ Agregar" styleClass="btn-secundario" onAction="#onAgregarDetalle"/>
                    <Button text="Quitar"    styleClass="btn-secundario" onAction="#onQuitarDetalle"/>
                </HBox>

                <TableView fx:id="tblDetalle" prefHeight="240" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colIng"      text="Ingrediente" prefWidth="260"/>
                        <TableColumn fx:id="colCant"     text="Cantidad"    prefWidth="120"/>
                        <TableColumn fx:id="colUni"      text="Unidad"      prefWidth="90"/>
                        <TableColumn fx:id="colPrecio"   text="Precio u."   prefWidth="140"/>
                        <TableColumn fx:id="colSubtotal" text="Subtotal"    prefWidth="140"/>
                    </columns>
                </TableView>
            </VBox>

            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Label fx:id="lblMensaje" styleClass="error" visible="false" managed="false" wrapText="true"/>
                <HBox HBox.hgrow="ALWAYS"/>
                <Label text="Total:"/>
                <Label fx:id="lblTotal" text="RD$ 0.00" styleClass="subtitulo"/>
                <Button text="Cancelar" styleClass="btn-secundario" onAction="#onVolver"/>
                <Button text="Registrar compra" styleClass="btn-principal" onAction="#onRegistrar"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
