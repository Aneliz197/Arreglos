<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.rosato.controlador.ListadoProveedoresController"
            prefWidth="960" prefHeight="620" styleClass="root">

    <top>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <padding><Insets top="14" right="20" bottom="12" left="20"/></padding>
            <Label text="Proveedores" styleClass="titulo"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button text="+ Nuevo"  styleClass="btn-principal"  onAction="#onNuevo"/>
            <Button text="Editar"   styleClass="btn-secundario" onAction="#onEditar"/>
            <Button text="Refrescar" styleClass="btn-secundario" onAction="#onRefrescar"/>
            <Button text="Volver"    styleClass="btn-secundario" onAction="#onVolver"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="10">
            <padding><Insets top="6" right="20" bottom="20" left="20"/></padding>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="txtBuscar" promptText="Buscar por nombre, teléfono o RNC" prefWidth="360"/>
                <Button text="Buscar" styleClass="btn-principal" onAction="#onBuscar"/>
            </HBox>

            <TableView fx:id="tblProveedores" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId"        text="ID"        prefWidth="60"/>
                    <TableColumn fx:id="colNombre"    text="Nombre"    prefWidth="240"/>
                    <TableColumn fx:id="colRnc"       text="RNC"       prefWidth="140"/>
                    <TableColumn fx:id="colTelefono"  text="Teléfono"  prefWidth="140"/>
                    <TableColumn fx:id="colEmail"     text="Email"     prefWidth="200"/>
                    <TableColumn fx:id="colDireccion" text="Dirección" prefWidth="180"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
