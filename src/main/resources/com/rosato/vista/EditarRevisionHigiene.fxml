<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.rosato.controlador.EditarRevisionHigieneController"
            prefWidth="960" prefHeight="740" styleClass="root">
    <top>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <padding><Insets top="14" right="20" bottom="12" left="20"/></padding>
            <Label fx:id="lblTitulo" text="Nueva revisión" styleClass="titulo"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button text="Volver" styleClass="btn-secundario" onAction="#onVolver"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="14">
            <padding><Insets top="6" right="20" bottom="20" left="20"/></padding>

            <VBox styleClass="tarjeta" spacing="8">
                <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>
                <Label text="Cabecera" styleClass="subtitulo"/>
                <GridPane hgap="12" vgap="10">
                    <Label text="Fecha *"      GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <DatePicker fx:id="dpFecha" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="Área *"       GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <ChoiceBox fx:id="cbArea" prefWidth="220"
                               GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Responsable"  GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextField fx:id="txtResponsable" prefWidth="260"
                               GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                    <Label text="Observaciones" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <TextArea fx:id="txtObservaciones" prefRowCount="2" prefWidth="420"
                              GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                </GridPane>
            </VBox>

            <VBox styleClass="tarjeta" spacing="8">
                <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Checklist" styleClass="subtitulo"/>
                    <HBox HBox.hgrow="ALWAYS"/>
                    <Button text="+ Item"    styleClass="btn-secundario" onAction="#onAgregarItem"/>
                    <Button text="Quitar"    styleClass="btn-secundario" onAction="#onQuitarItem"/>
                    <Button text="Predefinidos" styleClass="btn-secundario" onAction="#onPredefinidos"/>
                </HBox>
                <TableView fx:id="tblItems" editable="true" prefHeight="260">
                    <columns>
                        <TableColumn fx:id="colDesc"    text="Descripción"   prefWidth="360"/>
                        <TableColumn fx:id="colCumple"  text="Cumple"        prefWidth="80"/>
                        <TableColumn fx:id="colObs"     text="Observación"   prefWidth="320"/>
                    </columns>
                </TableView>
                <Label fx:id="lblResumen" styleClass="subtitulo"/>
                <Label fx:id="lblMensaje" styleClass="error" visible="false" managed="false" wrapText="true"/>
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button text="Cancelar" styleClass="btn-secundario" onAction="#onVolver"/>
                    <Button text="Guardar"  styleClass="btn-principal"  onAction="#onGuardar"/>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
