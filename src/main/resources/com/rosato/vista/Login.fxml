<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.rosato.controlador.LoginController"
           prefWidth="460" prefHeight="560" styleClass="root">
    <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>

    <VBox spacing="14" alignment="CENTER" styleClass="tarjeta" maxWidth="380">
        <Label text="Repostería Rosato" styleClass="titulo"/>
        <Label text="Inicio de sesión" styleClass="subtitulo"/>

        <VBox spacing="6">
            <Label text="Usuario"/>
            <TextField fx:id="txtUsuario" promptText="usuario"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Contraseña"/>
            <PasswordField fx:id="txtContrasena" promptText="••••••••"/>
        </VBox>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <CheckBox fx:id="chkRecordarme" text="Recordarme"/>
            <Hyperlink fx:id="lnkOlvidoPass" text="¿Olvidaste tu contraseña?"
                       onAction="#onOlvidoPassword"/>
        </HBox>

        <Label fx:id="lblMensaje" styleClass="error" visible="false" managed="false"/>

        <Button fx:id="btnIngresar" text="Iniciar Sesión"
                styleClass="btn-principal" maxWidth="Infinity"
                onAction="#onIngresar"/>

        <HBox spacing="6" alignment="CENTER">
            <Label text="¿Nuevo cliente?"/>
            <Hyperlink fx:id="lnkRegistro" text="Registrarse"
                       onAction="#onRegistro"/>
        </HBox>

        <Label fx:id="lblRolDetectado" styleClass="subtitulo"/>
    </VBox>
</StackPane>
