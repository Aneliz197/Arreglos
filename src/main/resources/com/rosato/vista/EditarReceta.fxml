<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.rosato.controlador.EditarRecetaController"
            prefWidth="920" prefHeight="640" styleClass="root">

    <top>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <padding><Insets top="14" right="20" bottom="12" left="20"/></padding>
            <Label fx:id="lblTitulo" text="Nueva receta" styleClass="titulo"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button text="Volver" styleClass="btn-secundario" onAction="#onVolver"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="14">
            <padding><Insets top="6" right="20" bottom="20" left="20"/></padding>

            <VBox styleClass="tarjeta" spacing="8">
                <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>
                <Label text="Cabecera" styleClass="subtitulo"/>
                <GridPane hgap="12" vgap="8">
                    <Label text="Tipo producto *" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <ChoiceBox fx:id="cbTipo" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="220"/>

                    <Label text="Nombre receta *" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="320"/>

                    <Label text="Notas" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextArea fx:id="txtNotas" GridPane.columnIndex="1" GridPane.rowIndex="2"
                              prefRowCount="3" prefWidth="420"/>

                    <CheckBox fx:id="chkActiva" text="Activa" selected="true"
                              GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                </GridPane>
            </VBox>

            <VBox styleClass="tarjeta" spacing="8">
                <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>
                <Label text="Ingredientes por libra" styleClass="subtitulo"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <ComboBox fx:id="cbIngrediente" prefWidth="300" promptText="Ingrediente"/>
                    <TextField fx:id="txtCantidad" prefWidth="140" promptText="Cantidad por libra"/>
                    <Button text="+ Agregar" styleClass="btn-secundario" onAction="#onAgregar"/>
                    <Button text="Quitar"    styleClass="btn-secundario" onAction="#onQuitar"/>
                </HBox>
                <TableView fx:id="tblIngr" prefHeight="240" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colIng"  text="Ingrediente"       prefWidth="300"/>
                        <TableColumn fx:id="colUni"  text="Unidad"            prefWidth="100"/>
                        <TableColumn fx:id="colCant" text="Cant. / libra"     prefWidth="160"/>
                    </columns>
                </TableView>
            </VBox>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Label fx:id="lblMensaje" styleClass="error" visible="false" managed="false" wrapText="true"/>
                <HBox HBox.hgrow="ALWAYS"/>
                <Button text="Cancelar" styleClass="btn-secundario" onAction="#onVolver"/>
                <Button text="Guardar"  styleClass="btn-principal"  onAction="#onGuardar"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
