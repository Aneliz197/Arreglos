<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.rosato.controlador.ListadoMantenimientosController"
            prefWidth="1100" prefHeight="640" styleClass="root">

    <top>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <padding><Insets top="14" right="20" bottom="12" left="20"/></padding>
            <Label fx:id="lblTitulo" text="Historial de mantenimientos" styleClass="titulo"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button text="+ Nuevo"   styleClass="btn-principal"  onAction="#onNuevo"/>
            <Button text="Refrescar" styleClass="btn-secundario" onAction="#onRefrescar"/>
            <Button text="Volver"    styleClass="btn-secundario" onAction="#onVolver"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="10">
            <padding><Insets top="6" right="20" bottom="20" left="20"/></padding>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Desde:"/>
                <DatePicker fx:id="dpDesde"/>
                <Label text="Hasta:"/>
                <DatePicker fx:id="dpHasta"/>
                <Button text="Buscar" styleClass="btn-principal" onAction="#onBuscar"/>
                <Button text="Quitar filtros" styleClass="btn-secundario" onAction="#onLimpiar"/>
                <Label fx:id="lblFiltroMaquina"/>
            </HBox>

            <TableView fx:id="tblMants" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId"      text="ID"        prefWidth="60"/>
                    <TableColumn fx:id="colFecha"   text="Fecha"     prefWidth="110"/>
                    <TableColumn fx:id="colMaquina" text="Máquina"   prefWidth="200"/>
                    <TableColumn fx:id="colTipo"    text="Tipo"      prefWidth="110"/>
                    <TableColumn fx:id="colTecnico" text="Técnico"   prefWidth="160"/>
                    <TableColumn fx:id="colCosto"   text="Costo"     prefWidth="100"/>
                    <TableColumn fx:id="colProxRev" text="Próx. rev." prefWidth="110"/>
                    <TableColumn fx:id="colDesc"    text="Descripción" prefWidth="220"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
